{
  // VS Code settings

  // Editor
  "editor.acceptSuggestionOnEnter": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.codeLens": true,
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 8,
  "editor.detectIndentation": true,
  "editor.foldingStrategy": "auto",
  "editor.fontFamily": "CommitMono Nerd Font Mono, monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.lineHeight": 0,
  "editor.lineNumbers": "on",
  "editor.linkedEditing": true,
  "editor.matchBrackets": "always",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderControlCharacters": false,
  "editor.renderFinalNewline": "on",
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "boundary",
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.tabCompletion": "on",
  "editor.trimAutoWhitespace": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.wordWrap": "off",

  // Explorer
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  // Keep related TypeScript sidecar files discoverable without letting them
  // dominate the Explorer tree. This changes presentation only, not paths.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.js, ${capture}.d.ts, ${capture}.d.ts.map",
    "*.tsx": "${capture}.stories.tsx, ${capture}.stories.ts, ${capture}.test.ts, ${capture}.spec.ts, ${capture}.test.tsx, ${capture}.spec.tsx",
    "index.tsx": "${dirname}.stories.tsx, ${dirname}.test.ts, ${dirname}.spec.ts, ${dirname}.test.tsx, ${dirname}.spec.tsx"
  },

  // Extension management
  // VS Code and extensions are maintained through explicit user actions.
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",

  // Files
  "files.autoGuessEncoding": true,
  "files.autoSave": "off",
  "files.trimFinalNewlines": true,

  // Source control
  "git.autofetch": false,
  "git.confirmSync": true,
  "git.enableSmartCommit": false,

  // Built-in language features
  "html.autoClosingTags": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "js/ts.autoClosingTags.enabled": true,
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "svg.preview.mode": "svg",
  "typescript.preferences.includePackageJsonAutoImports": "on",

  // Search and security
  "search.smartCase": true,
  "security.promptForLocalFileProtocolHandling": true,

  // Telemetry
  "telemetry.telemetryLevel": "off",

  // Terminal
  "terminal.integrated.fontFamily": "CommitMono Nerd Font Mono",
  "terminal.integrated.fontSize": 16,

  // Updates
  // The package manager owns VS Code releases on maintained platforms.
  "update.mode": "none",

  // Window and workbench
  "window.commandCenter": false,
  "window.zoomLevel": 0.5,
  "workbench.colorTheme": "Paper Custom",
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",

  // Extension settings

  // Biome (biomejs.biome)
  // Only activate Biome where the project explicitly provides biome.json.
  "biome.requireConfiguration": true,

  // Color Highlight (naumovs.color-highlight)
  "color-highlight.markerType": "underline",
  "color-highlight.markRuler": false,

  // Tailwind CSS IntelliSense (bradlc.vscode-tailwindcss)
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],

  // VSCodeVim (vscodevim.vim)
  // Mirrors the core editing workflow from config/nvim/init.lua.
  "vim.hlsearch": true,
  "vim.ignorecase": true,
  "vim.incsearch": true,
  "vim.joinspaces": false,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.leader": "\\",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [","],
      "after": [":"]
    },
    {
      "before": ["j"],
      "after": ["g", "j"]
    },
    {
      "before": ["k"],
      "after": ["g", "k"]
    },
    {
      "before": ["0"],
      "after": ["g", "0"]
    },
    {
      "before": ["^"],
      "after": ["g", "^"]
    },
    {
      "before": ["$"],
      "after": ["g", "$"]
    },
    {
      "before": ["n"],
      "after": ["n", "z", "z"]
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z"]
    },
    {
      "before": ["*"],
      "after": ["*", "z", "z"]
    },
    {
      "before": ["#"],
      "after": ["#", "z", "z"]
    },
    {
      "before": ["U"],
      "after": ["<C-r>"]
    },
    {
      "before": ["Q"],
      "commands": []
    },
    {
      "before": ["<Esc>"],
      "commands": [":nohl"]
    },
    {
      "before": ["<leader>", "v"],
      "after": ["<C-v>"]
    },
    {
      "before": ["<leader>", "b", "b"],
      "commands": ["workbench.action.navigateBack"]
    },
    {
      "before": ["<leader>", "g", "g"],
      "commands": ["workbench.action.navigateForward"]
    },
    {
      "before": ["<leader>", "s", "s"],
      "commands": [
        "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup"
      ]
    },
    {
      "before": ["c"],
      "after": ["\"", "_", "c"]
    },
    {
      "before": ["C"],
      "after": ["\"", "_", "C"]
    },
    {
      "before": ["x"],
      "after": ["\"", "_", "x"]
    },
    {
      "before": ["X"],
      "after": ["\"", "_", "X"]
    },
    {
      "before": ["s"],
      "after": ["\"", "_", "s"]
    },
    {
      "before": ["S"],
      "after": ["\"", "_", "S"]
    },
    {
      "before": ["g", "r", "n"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": ["[", "b"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["]", "b"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["[", "t"],
      "commands": ["workbench.action.previousEditorInGroup"]
    },
    {
      "before": ["]", "t"],
      "commands": ["workbench.action.nextEditorInGroup"]
    },
    {
      "before": ["<leader>", "1"],
      "commands": ["workbench.action.focusLeftGroup"]
    },
    {
      "before": ["<leader>", "2"],
      "commands": ["workbench.action.focusBelowGroup"]
    },
    {
      "before": ["<leader>", "3"],
      "commands": ["workbench.action.focusAboveGroup"]
    },
    {
      "before": ["<leader>", "4"],
      "commands": ["workbench.action.focusRightGroup"]
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"]
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"]
    },
    {
      "before": ["]", "c"],
      "commands": ["workbench.action.editor.nextChange"]
    },
    {
      "before": ["[", "c"],
      "commands": ["workbench.action.editor.previousChange"]
    },
    {
      "before": ["<leader>", "a"],
      "commands": ["editor.action.selectAll"]
    }
  ],
  "vim.smartcase": true,
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [","],
      "after": [":"]
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    },
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["c"],
      "after": ["\"", "_", "c"]
    },
    {
      "before": ["C"],
      "after": ["\"", "_", "C"]
    },
    {
      "before": ["x"],
      "after": ["\"", "_", "x"]
    },
    {
      "before": ["X"],
      "after": ["\"", "_", "X"]
    },
    {
      "before": ["s"],
      "after": ["\"", "_", "s"]
    },
    {
      "before": ["S"],
      "after": ["\"", "_", "S"]
    },
    {
      "before": ["p"],
      "after": ["P"]
    },
    {
      "before": ["*"],
      "commands": ["editor.action.addSelectionToNextFindMatch"]
    },
    {
      "before": ["#"],
      "commands": ["editor.action.addSelectionToPreviousFindMatch"]
    }
  ]
}
