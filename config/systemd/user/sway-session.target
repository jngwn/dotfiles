[Unit]
Description=Sway desktop session
Documentation=man:sway(1)
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
Wants=waybar.service swaync.service swayidle.service swayosd.service ssh-agent.service
Wants=fcitx5.service network-manager-applet.service
Wants=lxqt-policykit-agent.service kanshi.service udiskie.service
Wants=cliphist-runtime.service cliphist-text.service cliphist-image.service
Wants=batsignal.service desktop-data-cleanup.path desktop-data-cleanup.timer
After=graphical-session-pre.target
