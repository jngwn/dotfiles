root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{c,h,cc,hh,cpp,cxx,hpp,hxx}]
max_line_length = 80

[*.rs]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.{java,groovy,gradle,kt,kts}]
indent_size = 4

[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
max_line_length = 0
trim_trailing_whitespace = false

[{COMMIT_EDITMSG,MERGE_MSG,git-rebase-todo}]
max_line_length = 72

[{.gitattributes,.gitignore}]
max_line_length = 0
