  "tokenColors": [
    {
      "name": "Default code",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#2f5f8f",
        "fontStyle": ""
      }
    },
    {
      "name": "Strong comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.preprocessor"
      ],
      "settings": {
        "foreground": "#254a70",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#216609"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#1e6fcc"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#158c86",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5c21a5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "entity.other.attribute-name",
        "variable.other.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#158c86"
      }
    },
    {
      "name": "Macros, decorators, and regular expressions",
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "meta.decorator",
        "punctuation.decorator",
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a55000"
      }
    },
    {
      "name": "Tags and components",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#216609"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#1e6fcc"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": {
        "foreground": "#158c86",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#2f5f8f"
      }
    },
    {
      "name": "Inserted diff",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#000000",
        "background": "#c5d9b8"
      }
    },
    {
      "name": "Changed diff",
      "scope": [
        "markup.changed",
        "meta.diff.range",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#000000",
        "background": "#ffd866",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deleted diff",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#9f3a30"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated",
        "message.error"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#7f1d1d",
        "fontStyle": "bold"
      }
    }
  ],
