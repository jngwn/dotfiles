[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input
    pager = delta

[user]
    useConfigOnly = true

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = simple
    autoSetupRemote = true

[fetch]
    prune = true

[rerere]
    enabled = true

[includeIf "gitdir/i:~/Projects/work/"]
    path = ~/.gitconfig-work

[includeIf "gitdir/i:~/Projects/personal/"]
    path = ~/.gitconfig-personal

[includeIf "gitdir/i:~/Projects/opensource/"]
    path = ~/.gitconfig-opensource

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = true
    line-numbers = true
    side-by-side = true

[merge]
    conflictStyle = zdiff3
    tool = nvimdiff

[mergetool]
    keepBackup = false
    prompt = false

[mergetool "nvimdiff"]
    cmd = nvim -d "$LOCAL" "$BASE" "$REMOTE" "$MERGED"
    trustExitCode = true

[diff]
    tool = nvimdiff

[difftool]
    prompt = false

[difftool "nvimdiff"]
    cmd = nvim -d "$LOCAL" "$REMOTE"
